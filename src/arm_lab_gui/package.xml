<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>arm_lab_gui</name>
  <version>1.0.0</version>
  <description>
    Qt dashboard showing joint speed and torque, payload capacity at the TCP and
    live pass/fail against the target specification, plus headless nodes that
    publish the same figures.
  </description>
  <maintainer email="farouk15160@gmail.com">farouk</maintainer>
  <license>Apache-2.0</license>

  <depend>arm_lab_model</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>trajectory_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>python_qt_binding</depend>
  <depend>python3-numpy</depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
