<?xml version="1.0" ?>
<!-- Test bench for the rover arm. The gravity value is rewritten at launch
     when you pass gravity:=<value>, so the same world serves Earth, Mars and
     Moon studies. -->
<sdf version="1.9">
  <world name="arm_lab">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-forcetorque-system"
            name="gz::sim::systems::ForceTorque"/>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.55 0.62 0.72 1</background>
      <grid>true</grid>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.4 0.3 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>60 60</size></plane></geometry>
          <material>
            <ambient>0.42 0.38 0.32 1</ambient>
            <diffuse>0.52 0.47 0.40 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Sample targets. Grab them to check the payload figures for real. -->
    <model name="sample_2kg">
      <pose>0.75 0.0 0.04 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>2.0</mass>
          <inertia><ixx>0.00107</ixx><iyy>0.00107</iyy><izz>0.00107</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.08 0.08 0.08</size></box></geometry>
          <surface><friction><ode><mu>1.4</mu><mu2>1.4</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.08 0.08 0.08</size></box></geometry>
          <material>
            <ambient>0.75 0.35 0.08 1</ambient><diffuse>0.9 0.45 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="sample_3kg">
      <pose>0.55 -0.35 0.045 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>3.0</mass>
          <inertia><ixx>0.00203</ixx><iyy>0.00203</iyy><izz>0.00203</izz>
                   <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="collision">
          <geometry><box><size>0.09 0.09 0.09</size></box></geometry>
          <surface><friction><ode><mu>1.4</mu><mu2>1.4</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.09 0.09 0.09</size></box></geometry>
          <material>
            <ambient>0.15 0.45 0.7 1</ambient><diffuse>0.2 0.55 0.85 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
